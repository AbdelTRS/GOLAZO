# Copie ce fichier en .env.local et remplis les valeurs. Ne jamais committer .env.local.

# Base PostgreSQL Neon : Dashboard Neon > Connect > chaîne "Pooled connection"
DATABASE_URL=

# Secret Better Auth (sessions + signature des boosters invités) : 32 caractères aléatoires ou plus
# Génération : npx @better-auth/cli secret   (ou : openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Application Discord : https://discord.com/developers/applications > OAuth2
# Redirect à déclarer : http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Envoi des liens magiques (optionnel en dev : sans clé, le lien s'affiche dans le terminal)
RESEND_API_KEY=
EMAIL_FROM=GOLAZO <onboarding@resend.dev>
